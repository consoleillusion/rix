# Calamares integration.
#
# Rather than forking Calamares, we extend the stock
# `calamares-nixos-extensions` package:
#   * ship the `sekkos` branding component and point Calamares at it,
#   * replace the desktop chooser with a Plasma-first, SekkOS-branded one,
#   * patch the generated `configuration.nix` so installed systems carry
#     the SekkOS identity as well, and write a matching `flake.nix`.
#
# `pkgs.calamares-nixos` resolves `calamares-nixos-extensions` from the final
# package set, so overriding that one attribute is enough for the whole ISO.
{ config, lib, ... }:
let
  cfg = config.sekkos.installer.calamares;
in
{
  options.sekkos.installer.calamares.enable = lib.mkOption {
    type = lib.types.bool;
    default = true;
    description = "Install the SekkOS-branded Calamares installer.";
  };

  config = lib.mkIf cfg.enable {
    nixpkgs.overlays = [
      (_final: prev:
        let
          base = prev.calamares-nixos-extensions;

          # The flake written to the installed system should stay on the
          # same release channel this ISO was built from. Unstable releases
          # carry a "pre" suffix, so map those to nixos-unstable.
          nixpkgsBranch =
            if prev.lib.hasInfix "pre" prev.lib.trivial.release then
              "nixos-unstable"
            else
              "nixos-${prev.lib.trivial.release}";

          # The NixOS Calamares module parses the desktop choice from the
          # packagechooser instance. The ids below must keep matching the ids
          # handled by `modules/nixos/main.py` upstream.
          packageChooser = prev.writeText "packagechooser.conf" ''
            # Generated by the SekkOS flake; see modules/calamares.nix.
            mode: required
            method: legacy

            labels:
                step: Desktop

            default: plasma6

            items:
                - id: plasma6
                  packages: [ plasma6 ]
                  name: SekkOS Desktop (Plasma 6)
                  screenshot: "${base}/share/calamares/branding/nixos/images/plasma6.jpg"
                  description: "<html>SekkOS ships the Plasma 6 desktop by default: a fast, familiar and highly customisable workspace. The full NixOS package set is available whenever you want more applications.</html>"

                - id: ""
                  packages: [ ]
                  name: Minimal system
                  screenshot: "${base}/share/calamares/branding/nixos/images/nodesktop.jpg"
                  description: "<html>A console-only SekkOS system. Choose this for servers, appliances, or if you plan to configure the desktop yourself.</html>"
          '';
        in
        {
          calamares-nixos-extensions = base.overrideAttrs (old: {
            postInstall = (old.postInstall or "") + ''
              install -Dm0644 ${packageChooser} $out/etc/calamares/modules/packagechooser.conf

              mkdir -p $out/share/calamares/branding
              cp -r ${../calamares/branding/sekkos} $out/share/calamares/branding/sekkos

              substituteInPlace $out/etc/calamares/settings.conf \
                --replace-fail 'branding: nixos' 'branding: sekkos'

              # Brand the configuration written to the target system and
              # generate a flake for it.
              patch --batch -d $out/lib/calamares/modules/nixos -p1 \
                < ${../calamares/patches/installed-config-branding.patch}

              substituteInPlace $out/lib/calamares/modules/nixos/main.py \
                --replace-fail '@SEKKOS_NIXPKGS_BRANCH@' '${nixpkgsBranch}' \
                --replace-fail '@SEKKOS_SYSTEM@' '${prev.stdenv.hostPlatform.system}'
            '';
          });
        })
    ];
  };
}
