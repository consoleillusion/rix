@@ -311,6 +311,25 @@
 
 """
 
+# Rix: flake used to manage the installed system from the first rebuild on.
+# @RIX_NIXPKGS_BRANCH@ and @RIX_SYSTEM@ are filled in when the live image is
+# built; @@hostname@@ is filled in when the user completes the installer.
+cfgrixflake = """\
+{
+  description = "Rix system configuration (generated by the Rix live installer)";
+
+  # Flake-based by default. Run `nix flake update` to move the pin.
+  inputs.nixpkgs.url = "github:NixOS/nixpkgs/@RIX_NIXPKGS_BRANCH@";
+
+  outputs = { self, nixpkgs }: {
+    nixosConfigurations."@@hostname@@" = nixpkgs.lib.nixosSystem {
+      system = "@RIX_SYSTEM@";
+      modules = [ ./configuration.nix ];
+    };
+  };
+}
+"""
+
 cfgtail = """\
   # Some programs need SUID wrappers, can be configured further or are
   # started in user sessions.
@@ -355,6 +374,19 @@
   # For more information, see `man configuration.nix` or https://nixos.org/manual/nixos/stable/options#opt-system.stateVersion .
   system.stateVersion = "@@nixosversion@@"; # Did you read the comment?
 
+  # --- Rix branding, written by the live installer -------------------------
+  # `ID_LIKE=nixos` keeps software that special-cases NixOS working while
+  # the rest of /etc/os-release presents Rix as its own distribution.
+  system.nixos = {
+    distroName = "Rix";
+    distroId = "rix";
+    vendorName = "Rix";
+    vendorId = "rix";
+    extraOSReleaseArgs.ID_LIKE = "nixos";
+  };
+
+  nix.settings.experimental-features = [ "nix-command" "flakes" ];
+
 }
 """
 
