# SekkOS branding for Calamares. Strings here are what the installer shows.
# Keep the product name in sync with `system.nixos.distroName` in
# modules/common.nix.
---
componentName: sekkos

### WELCOME / OVERALL WORDING
welcomeStyleCalamares: false
welcomeExpandingLogo: true

### WINDOW
windowExpanding: normal
windowSize: 880px,560px
windowPlacement: center

### PANELS
sidebar: widget
navigation: widget

### STRINGS
strings:
    productName: "SekkOS"
    shortProductName: "SekkOS"
    version: "26.05"
    shortVersion: "26.05"
    versionedName: "SekkOS 26.05"
    shortVersionedName: "SekkOS"
    bootloaderEntryName: "SekkOS"
    # TODO: point these at real SekkOS sites.
    productUrl: "https://example.org/sekkos"
    supportUrl: "https://example.org/sekkos/support"
    knownIssuesUrl: "https://example.org/sekkos/issues"
    releaseNotesUrl: "https://example.org/sekkos/releases"
    donateUrl: ""

### IMAGES
# Paths are relative to this branding directory. Images are scaled by
# Calamares; SVGs are fine.
images:
    productIcon: "sekkos-mark.svg"
    productLogo: "sekkos-mark.svg"
    productWelcome: "sekkos-wordmark.svg"
    # productBanner: "sekkos-banner.svg"
    # productWallpaper: "wallpaper.png"

### COLORS
style:
    SidebarBackground: "#1B1035"
    SidebarText: "#F4F1FF"
    SidebarTextCurrent: "#1B1035"
    SidebarBackgroundCurrent: "#B69CFF"

### SLIDESHOW
slideshow: "show.qml"
slideshowAPI: 2
